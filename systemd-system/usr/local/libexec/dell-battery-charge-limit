#!/usr/bin/bash
set -euo pipefail

battery=/sys/class/power_supply/BAT0
charge_types="$battery/charge_types"

for _ in {1..30}; do
  [[ -e "$charge_types" ]] && break
  /usr/bin/sleep 1
done

if [[ ! -e "$charge_types" ]]; then
  echo "Dell battery charge controls did not appear within 30 seconds" >&2
  exit 1
fi

# Dell calls the Primarily AC Use preset "Trickle" in Linux's power-supply API.
printf 'Trickle\n' > "$charge_types"

grep -Fq '[Trickle]' "$charge_types"
