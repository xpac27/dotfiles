[Unit]
Description=SSHFS mount of rp3 Documents
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/sshfs -f -o BatchMode=yes,IdentitiesOnly=yes,IdentityFile=%h/.ssh/id_rsa,idmap=user,reconnect,ServerAliveInterval=15,ServerAliveCountMax=3 vinz@rp3:/mnt/data/vinz/Docs %h/mnt/ssh/Documents
ExecStop=/usr/bin/fusermount3 -u %h/mnt/ssh/Documents
Restart=on-failure
RestartSec=15
TimeoutStopSec=15

[Install]
WantedBy=default.target
