[Unit]
Description=SSHFS mount of rp3 Documents
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Let a broken connection exit; systemd retries without holding FUSE requests.
ExecStart=/usr/bin/sshfs -f -o BatchMode=yes,IdentitiesOnly=yes,IdentityFile=%h/.ssh/id_rsa,idmap=user,auto_unmount,ConnectTimeout=5,ConnectionAttempts=1,ServerAliveInterval=5,ServerAliveCountMax=2 vinz@rp3:/mnt/data/vinz/Docs %h/mnt/ssh/Documents
ExecStopPost=-/usr/bin/fusermount3 -u %h/mnt/ssh/Documents
Restart=always
RestartSec=15
TimeoutStopSec=5

[Install]
WantedBy=default.target
